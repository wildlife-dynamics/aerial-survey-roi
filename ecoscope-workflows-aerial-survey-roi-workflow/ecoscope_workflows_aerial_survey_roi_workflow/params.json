{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Set workflow details"
    },
    "retrieve_file_params": {
      "additionalProperties": false,
      "properties": {
        "input_method": {
          "anyOf": [
            {
              "$ref": "#/$defs/DownloadFile"
            },
            {
              "$ref": "#/$defs/LocalFile"
            }
          ],
          "default": null,
          "title": "Input Method",
          "description": "How to obtain the file: download from a URL or use a local file path"
        }
      },
      "type": "object",
      "required": [],
      "title": ""
    },
    "survey_lines": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "default": "North South",
          "enum": [
            "North South",
            "East West"
          ],
          "title": "Direction",
          "type": "string"
        },
        "spacing": {
          "default": 300,
          "title": "Spacing",
          "type": "integer"
        }
      },
      "required": [],
      "type": "object",
      "title": ""
    }
  },
  "$defs": {
    "DownloadFile": {
      "properties": {
        "url": {
          "description": "URL to download a file",
          "title": "URL",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "Download from URL",
      "type": "object"
    },
    "LocalFile": {
      "properties": {
        "file_path": {
          "description": "Path to a local file",
          "title": "Local file path",
          "type": "string"
        }
      },
      "required": [
        "file_path"
      ],
      "title": "Use local file",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "survey_lines": {
      "ui:order": [
        "direction",
        "spacing"
      ]
    },
    "ui:order": [
      "workflow_details",
      "retrieve_file_params",
      "survey_lines"
    ]
  },
  "additionalProperties": false
}
