{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Set workflow details"
    },
    "Define Region of Interest": {
      "type": "object",
      "description": "Define the region of interest for the aerial survey by uploading a geospatial file (GeoJSON, GeoPackage or GeoParquet) that contains the boundary of the area to be surveyed. This file will be loaded and processed to generate the survey lines.",
      "ecoscope:task_group": true,
      "properties": {
        "retrieve_file_params": {
          "additionalProperties": false,
          "properties": {
            "input_method": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DownloadFile"
                },
                {
                  "$ref": "#/$defs/LocalFile"
                }
              ],
              "default": null,
              "title": "Input Method",
              "description": "How to obtain the file: download from a URL or use a local file path"
            }
          },
          "type": "object",
          "required": [],
          "title": ""
        }
      }
    },
    "Draw Aerial Survey Lines": {
      "type": "object",
      "description": "Generate aerial survey lines across the defined region of interest based on the specified direction and spacing. The survey lines will be created as a geospatial dataframe and visualized on an interactive map.",
      "ecoscope:task_group": true,
      "properties": {
        "survey_lines": {
          "additionalProperties": false,
          "properties": {
            "direction": {
              "default": "North South",
              "enum": [
                "North South",
                "East West"
              ],
              "title": "Survey Direction (degrees)",
              "type": "string",
              "description": "Compass bearing the survey lines will run from the region of interest (0 = North, 90 = East)."
            },
            "spacing": {
              "default": 300,
              "title": "Line Spacing (m)",
              "type": "integer",
              "description": "Distance in metres between adjacent survey lines across the region of interest."
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    }
  },
  "$defs": {
    "DownloadFile": {
      "properties": {
        "url": {
          "description": "URL to download a file",
          "title": "URL",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "Download from URL",
      "type": "object"
    },
    "LocalFile": {
      "properties": {
        "file_path": {
          "description": "Path to a local file",
          "title": "Local file path",
          "type": "string"
        }
      },
      "required": [
        "file_path"
      ],
      "title": "Use local file",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "Draw Aerial Survey Lines": {
      "survey_lines": {
        "ui:order": [
          "direction",
          "spacing"
        ]
      }
    },
    "ui:order": [
      "workflow_details",
      "Define Region of Interest",
      "Draw Aerial Survey Lines"
    ]
  },
  "additionalProperties": false
}
